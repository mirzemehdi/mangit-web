# Copy to .env.local and fill in your own Firebase web app config.
# Firebase console > Project settings > Your apps > Web app > SDK config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# App Check. Extensions can't use reCAPTCHA attestation on chrome-extension://
# origins, so local and judging builds use a registered debug token.
# Firebase console > App Check > Apps > (your web app) > Manage debug tokens.
APP_CHECK_DEBUG_TOKEN=
# Optional: a reCAPTCHA Enterprise site key, used when no debug token is set.
RECAPTCHA_SITE_KEY=

# "agent-platform" (default, pay per use) or "gemini-developer".
AI_BACKEND=

# Web demo (hosted): its own Firebase web app, App Check via reCAPTCHA Enterprise.
WEB_FIREBASE_APP_ID=
WEB_RECAPTCHA_SITE_KEY=

# Chrome Web Store build (node scripts/build.mjs --store): its own registered debug token.
STORE_APP_CHECK_DEBUG_TOKEN=
